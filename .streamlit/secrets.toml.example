# Streamlit Community Cloud 部署用 secrets 模板
# 用法：在 share.streamlit.io 打开你的 App → Settings → Secrets，
# 把下面三行（去掉注释、填上真实值）粘贴进去保存，App 会自动重启生效。
# 注意：不要把填好真实 key 的文件提交到 git。

# LLM_API_KEY = "粘贴你的 key"
# LLM_BASE_URL = "https://api.openai.com/v1"
# LLM_MODEL = "gpt-4o-mini"

# 也可以直接用仓库里你已有的中转 key：
# 侧边栏「配置 LLM API Key」同样可用（按会话生效，无需重启）。
